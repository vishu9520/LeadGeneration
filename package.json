{
  "name": "outbound-lead-generator",
  "version": "1.0.0",
  "description": "MERN Stack Outbound Lead Generator for SaaS Startups",
  "main": "server/server.js",
  "scripts": {
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
